{
  "name": "tanstarter-cli",
  "version": "1.4.0",
  "description": "Create a TanStarter app from the template and deploy it to Cloudflare Workers in about 10 minutes.",
  "type": "module",
  "license": "MIT",
  "author": "TanStarter",
  "homepage": "https://github.com/MkFastHQ/tanstarter-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MkFastHQ/tanstarter-cli"
  },
  "bugs": {
    "url": "https://github.com/MkFastHQ/tanstarter-cli/issues"
  },
  "keywords": [
    "tanstarter",
    "tanstack",
    "cloudflare",
    "wrangler",
    "d1",
    "r2",
    "kv",
    "cli",
    "starter"
  ],
  "bin": {
    "tanstarter": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run test/index.test.ts",
    "test:template": "vitest run test/template-integration.test.ts",
    "prepublishOnly": "pnpm run build",
    "release:dry": "npm publish --dry-run",
    "release": "npm publish"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
